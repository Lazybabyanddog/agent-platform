# 复制为 backend/.env 后按需修改
APP_NAME=agent-platform
ENVIRONMENT=dev
DEBUG=false
API_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://agent_app:agent_app@localhost:5432/agent_platform
MIGRATION_DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent_platform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

REDIS_URL=redis://localhost:6380/0

RABBITMQ_URL=amqp://agent:agent@localhost:5672/
EVENTS_EXCHANGE=agent_platform.events
OUTBOX_PUBLISHER_ENABLED=true

# 会话删除的内容回收进程（agent_platform.workers.session_purge）
SESSION_PURGE_POLL_INTERVAL_S=5
SESSION_PURGE_BATCH_SIZE=50

JWT_SECRET=dev-only-insecure-jwt-secret-change-me
JWT_TTL_SECONDS=28800
SECRET_ENC_KEY=dev-only-32-byte-key-for-tests!!

SYNC_MAX_TIMEOUT_S=120
DEFAULT_MAX_STEPS=12
DEFAULT_TIMEOUT_S=90
DEFAULT_TOKEN_BUDGET=20000

LOG_LEVEL=INFO
LOG_JSON=true
# 留空只写 stdout（容器部署保持空）；设为目录后额外写 <目录>/api.log 与 <目录>/outbox.log
LOG_DIR=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
RETAIN_PROMPT_CONTENT=false
